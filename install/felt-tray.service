[Unit]
Description=Felt tray: her chat window, voice for typed replies, alert pop-ups
Documentation=file:///usr/share/doc/felt-tray/README.md
PartOf=graphical-session.target
After=graphical-session.target plasma-plasmashell.service
# your user must be able to read client_bundle (see config.toml)

[Service]
ExecStart=/usr/bin/felt-tray
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
